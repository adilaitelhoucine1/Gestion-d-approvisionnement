<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="017-create-table-auth-audit-logs" author="system">
        <createTable tableName="auth_audit_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="ip_address" type="VARCHAR(45)">
                <constraints nullable="true"/>
            </column>

            <column name="user_agent" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="details" type="VARCHAR(1000)">
                <constraints nullable="true"/>
            </column>

            <column name="error_message" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>

            <column name="action_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="affected_resource" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>

            <column name="old_value" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>

            <column name="new_value" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- Indexes for performance -->
        <createIndex tableName="auth_audit_logs" indexName="idx_auth_audit_user">
            <column name="username"/>
        </createIndex>

        <createIndex tableName="auth_audit_logs" indexName="idx_auth_audit_action">
            <column name="action"/>
        </createIndex>

        <createIndex tableName="auth_audit_logs" indexName="idx_auth_audit_date">
            <column name="action_date"/>
        </createIndex>

        <createIndex tableName="auth_audit_logs" indexName="idx_auth_audit_status">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropTable tableName="auth_audit_logs"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

