<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="018-make-password-nullable" author="adil">
        <comment>Make users.password nullable to support Keycloak authentication</comment>

        <modifyDataType tableName="users"
                        columnName="password"
                        newDataType="VARCHAR(255)"/>

        <dropNotNullConstraint tableName="users"
                               columnName="password"
                               columnDataType="VARCHAR(255)"/>

        <rollback>
            <addNotNullConstraint tableName="users"
                                  columnName="password"
                                  columnDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

